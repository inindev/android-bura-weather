<!-- Widget layout; views are populated by WidgetRenderer via RemoteViews. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Bottom layer: transparent catcher. Consumes taps on non-interactive regions so they
         don't fall through to the launcher's "open owning app" fallback. Interactive views
         live on the content layer above and win touches by z-order (top-most first), so an
         ancestor can never swallow them. -->
    <ImageView
        android:id="@+id/widget_background_catcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:background="@android:color/transparent" />

    <!-- Top layer: the actual widget content. -->
    <LinearLayout
        android:id="@+id/widget_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/widget_background"
        android:orientation="vertical"
        android:paddingTop="8dp">

    <!-- ROW 1 — Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp">

        <TextView
            android:id="@+id/widget_location"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/widget_placeholder_location"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_today_high_low"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/widget_placeholder_high_low"
            android:textColor="#FFFFFF"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Hairline under the header -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:contentDescription="@null"
        android:background="#26000000" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:contentDescription="@null"
        android:background="#40FFFFFF" />

    <!-- MIDDLE — two independent columns so the LEFT divider (clock vs. readings) can sit at a
         different height than the RIGHT divider (icon vs. temperature). This is what a shared-row
         layout can't do. Each column is a top box over a bottom box with its own vertical split.
           LEFT  column: clock box (top) | Humidity/UV Index/Pressure box (bottom)
           RIGHT column: icon box (top)  | temperature/Feels Like/Condition box (bottom) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="56"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <!-- LEFT COLUMN. Vertical split: clock 30 / readings 24 — clock box taller, readings box
             shorter. Adjust these two weights to move the LEFT divider independently. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="60"
            android:orientation="vertical">

            <!-- Clock box (top) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="30"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingRight="8dp"
                    android:paddingTop="24dp"
                    android:paddingBottom="10dp"
                    android:text="@string/widget_placeholder_date"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/widget_alarm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/widget_placeholder_alarm"
                    android:textColor="#CCCCCC"
                    android:textSize="11sp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="bottom"
                    android:orientation="horizontal">

                    <TextClock
                        android:id="@+id/widget_clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="hh:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFF"
                        android:textSize="52sp"
                        android:textStyle="bold" />

                    <TextClock
                        android:id="@+id/widget_clock_ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="8dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#FFFFFF"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Humidity / UV Index / Pressure box (bottom) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="24"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/widget_humidity"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_placeholder_humidity"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/widget_uv"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/widget_placeholder_uv"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/widget_pressure"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/widget_placeholder_pressure"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- RIGHT COLUMN. Vertical split: icon 24 / temperature 32 — matches the previous rows so
             the big temperature is unchanged. Adjust these two to move the RIGHT divider. -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="40"
            android:orientation="vertical">

            <!-- Icon box (top) -->
            <ImageView
                android:id="@+id/widget_current_icon"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="24"
                android:contentDescription="@string/widget_placeholder_condition"
                android:padding="8dp"
                android:src="@drawable/moon_for_dark"
                android:translationY="14dp" />

            <!-- Temperature / Feels Like / Condition box (bottom) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="32"
                android:gravity="bottom|center_horizontal"
                android:orientation="vertical"
                android:paddingBottom="34dp">

                <TextView
                    android:id="@+id/widget_temperature"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingStart="14dp"
                    android:text="@string/widget_placeholder_temp"
                    android:textColor="#FFFFFF"
                    android:textSize="46sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_feels_like"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_placeholder_feels_like"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/widget_condition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/widget_placeholder_condition"
                    android:textColor="#FFFFFF"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Hairline above the 5-day strip -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:contentDescription="@null"
        android:background="#26000000" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:contentDescription="@null"
        android:background="#40FFFFFF" />

    <!-- ROW 4 — 5-day forecast strip. Unique ids per column for RemoteViews binding. -->
    <LinearLayout
        android:id="@+id/widget_forecast_strip"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="24"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <LinearLayout
            android:id="@+id/widget_day1"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_day1_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_placeholder_day"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_day1_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginVertical="2dp"
                android:contentDescription="@string/widget_placeholder_condition"
                android:src="@drawable/rain_for_dark" />

            <TextView
                android:id="@+id/widget_day1_high_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_placeholder_high_low"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_day2"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_day2_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_placeholder_day"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_day2_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginVertical="2dp"
                android:contentDescription="@string/widget_placeholder_condition"
                android:src="@drawable/rain_for_dark" />

            <TextView
                android:id="@+id/widget_day2_high_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_placeholder_high_low"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_day3"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_day3_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_placeholder_day"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_day3_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginVertical="2dp"
                android:contentDescription="@string/widget_placeholder_condition"
                android:src="@drawable/rain_for_dark" />

            <TextView
                android:id="@+id/widget_day3_high_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_placeholder_high_low"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_day4"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_day4_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_placeholder_day"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_day4_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginVertical="2dp"
                android:contentDescription="@string/widget_placeholder_condition"
                android:src="@drawable/rain_for_dark" />

            <TextView
                android:id="@+id/widget_day4_high_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_placeholder_high_low"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/widget_day5"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center_horizontal|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_day5_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_placeholder_day"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/widget_day5_icon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginVertical="2dp"
                android:contentDescription="@string/widget_placeholder_condition"
                android:src="@drawable/rain_for_dark" />

            <TextView
                android:id="@+id/widget_day5_high_low"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/widget_placeholder_high_low"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

    <!-- Chamfer below the 5-day strip (above the footer) -->
    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:contentDescription="@null"
        android:background="#26000000" />

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="16dp"
        android:contentDescription="@null"
        android:background="#40FFFFFF" />

    <!-- FOOTER -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="8"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/widget_wind"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/widget_placeholder_wind"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="@string/widget_placeholder_updated"
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <!-- Chamfer separator before the refresh icon -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:contentDescription="@null"
            android:background="#26000000" />

        <ImageView
            android:layout_width="1dp"
            android:layout_height="16dp"
            android:layout_marginEnd="8dp"
            android:contentDescription="@null"
            android:background="#40FFFFFF" />

        <ImageView
            android:id="@+id/widget_refresh"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:contentDescription="@string/widget_refresh"
            android:src="@drawable/widget_refresh_icon" />

        <!-- Shown in place of the static ↻ while a refresh runs; the indeterminate sweep spins
             widget_refresh_spinning (the same ↻ icon wrapped in a rotate). -->
        <ProgressBar
            android:id="@+id/widget_refresh_progress"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:indeterminate="true"
            android:indeterminateDrawable="@drawable/widget_refresh_spinning"
            android:indeterminateDuration="800"
            android:visibility="gone" />
    </LinearLayout>
    </LinearLayout>

    <!-- Top-layer corner hotspot: enlarges the refresh touch target to the bottom-right corner.
         Transparent; sits above the content by z-order so it reliably wins the tap. -->
    <ImageView
        android:id="@+id/widget_refresh_hotspot"
        android:layout_width="52dp"
        android:layout_height="40dp"
        android:layout_gravity="bottom|end"
        android:contentDescription="@string/widget_refresh" />
</FrameLayout>
